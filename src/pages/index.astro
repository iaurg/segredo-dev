---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAllTopicos,
  getDestaques,
  getPostsByTopico,
  getRecentPosts,
} from '@/lib/data-utils'

const destaques = await getDestaques()
const recent = await getRecentPosts(6)
const topicos = await getAllTopicos()
const topicoCounts = await Promise.all(
  topicos.map(async (topico) => ({
    topico,
    count: (await getPostsByTopico(topico.id)).length,
  })),
)
---

<Layout
  title="Início"
  description="Explicações de tecnologia em português: kernel, shell, front-end, back-end e carreira. Escrito enquanto eu aprendo, por Italo Aurélio."
>
  <section class="flex flex-col gap-y-5 pt-2 pb-4">
    <h1 class="font-serif text-5xl leading-none font-semibold tracking-tight">
      <span class="grifo">segredo.dev</span>
    </h1>
    <p class="text-muted-foreground font-serif text-xl leading-snug italic">
      s.m. aquilo que ainda não te explicaram direito.
    </p>
    <p
      class="text-foreground/80 max-w-[58ch] font-serif text-lg leading-relaxed"
    >
      Escrevo explicações de tecnologia em português — as que eu queria ter
      achado quando estava estudando. Sou o Italo, programador, e publico aqui
      enquanto aprendo, seguindo o <Link
        href="/blog/aprenda-em-publico/"
        class="grifo-link decoration-foreground/35 underline underline-offset-4"
        >learn in public</Link
      >.
    </p>
  </section>

  {
    destaques.length > 0 && (
      <section class="flex flex-col gap-y-4">
        <h2 class="font-serif text-2xl font-semibold">Comece por aqui</h2>
        <ul class="flex flex-col gap-y-4">
          {destaques.slice(0, 4).map((post, index) => (
            <li>
              <BlogCard entry={post} priority={index === 0} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="flex flex-col gap-y-4">
    <h2 class="font-serif text-2xl font-semibold">Tópicos</h2>
    <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
      {
        topicoCounts.map(({ topico, count }) => (
          <li>
            <a
              href={`/topicos/${topico.id}/`}
              class="group flex items-baseline gap-x-2 py-1"
            >
              <span
                class="size-2 shrink-0 rounded-full"
                style={`background-color: ${topico.data.tint}`}
                aria-hidden="true"
              />
              <span class="grifo-link font-medium">{topico.data.name}</span>
              <span class="text-muted-foreground text-xs">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col gap-y-4">
    <div class="flex items-baseline justify-between gap-x-4">
      <h2 class="font-serif text-2xl font-semibold">Últimos posts</h2>
      <Link
        href="/blog/"
        class="grifo-link text-muted-foreground hover:text-foreground text-sm"
      >
        ver todos
      </Link>
    </div>
    <ul class="flex flex-col gap-y-4">
      {
        recent.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
