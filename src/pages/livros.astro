---
import BookCard from '@/components/BookCard.astro'
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'

const books = await getCollection('books')

const byTitle = (
  a: { data: { title: string } },
  b: { data: { title: string } },
) => a.data.title.localeCompare(b.data.title)

const readingBooks = books
  .filter((book) => book.data.status === 'lendo')
  .sort(byTitle)
const toReadBooks = books
  .filter((book) => book.data.status === 'na-lista')
  .sort(byTitle)
const readBooks = books
  .filter((book) => book.data.status === 'lido')
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0) || byTitle(a, b))

const groups = [
  { id: 'lendo', title: 'Lendo agora', tint: '#0ea5e9', items: readingBooks },
  { id: 'na-lista', title: 'Na lista', tint: '#f59e0b', items: toReadBooks },
  { id: 'lido', title: 'Já li', tint: '#22c55e', items: readBooks },
]

const filters = [
  { id: 'all', label: 'Todos', count: books.length, tint: null },
  ...groups.map((group) => ({
    id: group.id,
    label: group.title,
    count: group.items.length,
    tint: group.tint,
  })),
]
---

<Layout
  title="Livros"
  description="Os livros que li, os que estou lendo e os que estão na fila — com o que achei de cada um."
>
  <Breadcrumbs items={[{ label: 'Livros', icon: 'lucide:book-open' }]} />

  <section class="flex flex-col gap-y-4">
    <h1 class="font-serif text-4xl leading-none font-semibold tracking-tight">
      Livros
    </h1>
    <p
      class="text-foreground/80 max-w-[58ch] font-serif text-lg leading-relaxed"
    >
      O que estou lendo, o que já li e o que está na fila. Programação, sim, mas
      também as coisas que mudaram como eu penso sobre o trabalho.
    </p>

    <div class="flex flex-wrap gap-x-4 gap-y-2" id="filter-buttons">
      {
        filters.map((filter) => (
          <button
            type="button"
            data-filter={filter.id}
            aria-pressed={filter.id === 'all' ? 'true' : 'false'}
            class="filter-btn text-muted-foreground hover:text-foreground aria-pressed:text-foreground inline-flex cursor-pointer items-center gap-x-1.5 text-sm transition-colors aria-pressed:font-medium"
          >
            {filter.tint && (
              <span
                class="size-2 shrink-0 rounded-full"
                style={`background-color: ${filter.tint}`}
                aria-hidden="true"
              />
            )}
            {filter.label}
            <span class="text-muted-foreground text-xs">{filter.count}</span>
          </button>
        ))
      }
    </div>
  </section>

  {
    groups.map(
      (group) =>
        group.items.length > 0 && (
          <section
            class="book-section flex flex-col gap-y-4"
            data-status={group.id}
          >
            <h2 class="flex items-baseline gap-x-2 font-serif text-2xl font-semibold">
              <span
                class="size-2 shrink-0 rounded-full"
                style={`background-color: ${group.tint}`}
                aria-hidden="true"
              />
              {group.title}
              <span class="text-muted-foreground text-sm font-normal">
                {group.items.length}
              </span>
            </h2>

            <ul class="grid gap-4 lg:grid-cols-2">
              {group.items.map((book) => (
                <li>
                  <BookCard book={book} />
                </li>
              ))}
            </ul>
          </section>
        ),
    )
  }

  {
    books.length === 0 && (
      <p class="text-muted-foreground">
        A estante está vazia por enquanto. Volte depois.
      </p>
    )
  }
</Layout>

<script>
  // Filtering is presentational: styling lives in CSS via aria-pressed.
  {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn')
    const sections = document.querySelectorAll<HTMLElement>('.book-section')

    const apply = (filter: string) => {
      buttons.forEach((button) =>
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.filter === filter),
        ),
      )
      sections.forEach((section) => {
        section.hidden = filter !== 'all' && section.dataset.status !== filter
      })
      history.replaceState(null, '', filter === 'all' ? ' ' : `#${filter}`)
    }

    buttons.forEach((button) =>
      button.addEventListener('click', () => apply(button.dataset.filter!)),
    )

    const fromHash = window.location.hash.slice(1)
    if (['lendo', 'na-lista', 'lido'].includes(fromHash)) apply(fromHash)
  }
</script>
