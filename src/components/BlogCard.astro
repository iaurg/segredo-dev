---
import { Badge } from '@/components/ui/badge'
import { Separator } from '@/components/ui/separator'
import { parseAuthors } from '@/lib/data-utils'
import { formatDate, readingTime } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import { getEntry, type CollectionEntry } from 'astro:content'
import Link from './Link.astro'

interface Props {
  entry: CollectionEntry<'blog'>
  /** First card in a list: its image is the LCP candidate, so load it eagerly. */
  priority?: boolean
}

const { entry, priority = false } = Astro.props
const formattedDate = formatDate(entry.data.date, 'pt-BR')
const readTime = readingTime(entry.body!)
const authors = await parseAuthors(entry.data.authors ?? [])
const topico = await getEntry(entry.data.topico)
---

<div
  class="hover:bg-secondary/50 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <Link
    href={`/${entry.collection}/${entry.id}/`}
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={512}
            height={269}
            widths={[256, 512]}
            sizes="256px"
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            class="object-cover"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">{entry.data.title}</h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <img
                    src={author.avatar}
                    alt={author.name}
                    width={20}
                    height={20}
                    loading="lazy"
                    decoding="async"
                    class="size-5 rounded-full"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" className="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" className="h-4!" />
        <span>{readTime}</span>
      </div>

      <div class="flex flex-wrap gap-2">
        <Badge variant="secondary" className="flex items-center gap-x-1">
          <Icon name="lucide:library" class="size-3" />
          {topico.data.name}
        </Badge>
        {
          entry.data.destaque && (
            <Badge variant="outline" className="flex items-center gap-x-1">
              <Icon name="lucide:sparkles" class="size-3" />
              Comece por aqui
            </Badge>
          )
        }
      </div>
    </div>
  </Link>
</div>
