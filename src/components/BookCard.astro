---
import Link from '@/components/Link.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  book: CollectionEntry<'books'>
}

const { book } = Astro.props

const status = {
  lido: { label: 'Lido', tint: '#22c55e' },
  lendo: { label: 'Lendo', tint: '#0ea5e9' },
  'na-lista': { label: 'Na lista', tint: '#f59e0b' },
}[book.data.status]
---

<article
  class="hover:bg-secondary/40 flex h-full gap-x-5 rounded-lg border p-4 transition-colors"
>
  <Image
    src={book.data.image}
    alt={`Capa de ${book.data.title}`}
    width={112}
    height={168}
    widths={[112, 224]}
    sizes="112px"
    loading="lazy"
    decoding="async"
    class="h-30 w-20 shrink-0 self-start rounded-sm object-cover shadow-sm sm:h-42 sm:w-28"
  />

  <div class="flex min-w-0 flex-1 flex-col gap-y-2">
    <div>
      <h3 class="line-clamp-2 font-serif text-xl leading-snug font-semibold">
        {book.data.title}
      </h3>
      {
        book.data.author && (
          <p class="text-muted-foreground text-sm">
            {book.data.author}
            {book.data.year && <span> · {book.data.year}</span>}
          </p>
        )
      }
    </div>

    <p class="text-foreground/80 line-clamp-3 font-serif leading-relaxed">
      {book.data.description}
    </p>

    <div
      class="text-muted-foreground mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-sm"
    >
      <span class="inline-flex items-center gap-x-1.5">
        <span
          class="size-2 shrink-0 rounded-full"
          style={`background-color: ${status.tint}`}
          aria-hidden="true"></span>
        {status.label}
      </span>

      {
        book.data.rating && book.data.status === 'lido' && (
          <span aria-label={`Nota ${book.data.rating} de 5`}>
            {'★'.repeat(book.data.rating)}
            <span class="text-muted-foreground/30">
              {'★'.repeat(5 - book.data.rating)}
            </span>
          </span>
        )
      }

      <Link
        href={book.data.amazonLink}
        external
        class="grifo-link text-foreground inline-flex items-center gap-x-1"
      >
        Ver na Amazon
        <Icon name="lucide:external-link" class="size-3" />
      </Link>
    </div>
  </div>
</article>
